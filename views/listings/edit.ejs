<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title>Edit Listing — Wanderlust</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f7f7f7; }
    nav {
      background: #ff385c;
      padding: 14px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    nav h1 { color: white; font-size: 22px; }
    nav a {
      color: #ff385c; background: white;
      padding: 7px 14px; border-radius: 8px;
      text-decoration: none; font-weight: bold; font-size: 13px;
    }
    .form-wrap {
      max-width: 600px;
      margin: 40px auto;
      background: white;
      padding: 32px;
      border-radius: 16px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    }
    h2 { font-size: 22px; margin-bottom: 24px; color: #222; }
    label { font-size: 13px; color: #555; display: block; margin-bottom: 6px; }
    input, textarea {
      width: 100%; padding: 10px 14px;
      border: 1px solid #ddd; border-radius: 8px;
      font-size: 15px; margin-bottom: 18px; outline: none;
    }
    input:focus, textarea:focus { border-color: #ff385c; }
    textarea { height: 100px; resize: none; }
    input[type="file"] { padding: 8px; cursor: pointer; }
    .current-img {
      width: 100%;
      border-radius: 8px;
      margin-bottom: 10px;
      max-height: 200px;
      object-fit: cover;
    }
    button {
      width: 100%; padding: 12px;
      background: #222; color: white;
      font-size: 16px; font-weight: bold;
      border: none; border-radius: 8px; cursor: pointer;
    }
    button:hover { background: #444; }
    @media (max-width: 600px) {
      .form-wrap { margin: 20px 16px; padding: 24px 20px; }
      nav h1 { font-size: 18px; }
    }
  </style>
</head>
<body>
 <%- include('../partials/navbar') %>
  <div class="form-wrap">
    <h2>Edit Listing ✏️</h2>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
      <label>Title</label>
      <input type="text" name="listing[title]" value="<%= listing.title %>" required />
      <label>Description</label>
      <textarea name="listing[description]"><%= listing.description %></textarea>
      <% if (listing.image && listing.image.url) { %>
        <label>Current Image</label>
        <img class="current-img" src="<%= listing.image.url %>" alt="current image" />
      <% } %>
      <label>Change Image</label>
      <input type="file" name="listing[image]" accept="image/*" />
      <label>Price per night (₹)</label>
      <input type="number" name="listing[price]" value="<%= listing.price %>" />
      <label>Location</label>
      <input type="text" name="listing[location]" value="<%= listing.location %>" />
      <label>Country</label>
      <input type="text" name="listing[country]" value="<%= listing.country %>" />
      <button type="submit">Update Listing</button>
    </form>
  </div>
  <%- include('../partials/footer') %>
</body>
</html>